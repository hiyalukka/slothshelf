# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=slothshelf

OLLAMA_HOST=http://localhost:11434
CARD_MODEL=gemma2:2b
EMBED_MODEL=nomic-embed-text

# Sites like Wikipedia block anonymous scripts. Put your own email here.
FETCH_USER_AGENT=SlothShelf/0.1 (personal reading triage; contact: you@example.com) httpx

# Max characters of page text sent to the model (smaller = faster on a laptop)
MAX_CHARS=6000
# Show "links you loved that look like this one" to the model (uses Vector Search)
TASTE_RETRIEVAL=true
